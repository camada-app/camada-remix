{
  "name": "@camada/remix",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "check:readme-build": "scripts/readme-build-check.sh"
  },
  "description": "camada SDK for React Router framework mode (Remix): snapshot enforcement in a root middleware, first-party challenge and beacon route, track() outcomes",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@camada/browser": "file:../camada-browser",
    "@camada/core": "file:../camada-core"
  },
  "peerDependencies": {
    "react-router": ">=7.9"
  },
  "devDependencies": {
    "@react-router/express": "^8.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "react-router": "^8.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
